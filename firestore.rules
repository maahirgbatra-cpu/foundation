rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function me(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function active(){return signedIn() && me().active == true;}
  function role(r){return active() && me().role == r;}
  function admin(){return role('super_admin');}
  function staff(){return admin() || role('teacher_admin') || role('content_admin');}
  function sameClass(d){return active() && d.className == me().className && (!('section' in d) || d.section == me().section);}
  match /users/{uid} {
   allow read: if signedIn() && (request.auth.uid == uid || admin());
   allow write: if false;
  }
  match /staff/{id} { allow read: if admin(); allow create,update,delete: if admin(); }
  match /classes/{id} { allow read: if active(); allow create,update,delete: if admin(); }
  match /students/{id} { allow read: if admin() || role('teacher_admin') || (role('student') && resource.data.email == request.auth.token.email); allow create,update,delete: if admin() || role('teacher_admin'); }
  match /subjects/{id} { allow read: if active(); allow write: if admin() || role('content_admin'); }
  match /materials/{id} {
   allow read: if admin() || role('content_admin') || (active() && (resource.data.className == me().className || resource.data.visibility == 'school'));
   allow create: if admin() || role('content_admin') || (role('teacher_admin') && request.resource.data.createdBy == request.auth.uid);
   allow update,delete: if admin() || (staff() && resource.data.createdBy == request.auth.uid);
  }
  match /homework/{id} {
   allow read: if admin() || role('teacher_admin') || (active() && sameClass(resource.data));
   allow create: if admin() || (role('teacher_admin') && request.resource.data.createdBy == request.auth.uid);
   allow update,delete: if admin() || (role('teacher_admin') && resource.data.createdBy == request.auth.uid);
  }
  match /announcements/{id} {
   allow read: if admin() || role('content_admin') || (active() && (resource.data.visibility == 'school' || sameClass(resource.data)));
   allow create: if admin() || role('content_admin');
   allow update,delete: if admin() || (role('content_admin') && resource.data.createdBy == request.auth.uid);
  }
  match /school_settings/{id} { allow read: if active(); allow create,update,delete: if admin(); }
  match /{document=**} { allow read,write: if false; }
 }
}
