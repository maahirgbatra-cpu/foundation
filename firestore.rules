rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function superAdmin(){return signedIn() && request.auth.uid == 'Y4YUHogoKoVo4bGGe7wOdWUZe5I2';}
  function hasProfile(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));}
  function p(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function active(){return superAdmin() || (hasProfile() && p().active == true);}
  function role(r){return active() && (superAdmin() || p().role in r);}
  function manager(){return superAdmin() || role(['principal','admin']);}
  function staff(){return manager() || role(['teacher','content_admin']);}
  function schoolOk(d){return superAdmin() || (active() && d.schoolId == p().schoolId);}
  function validSchool(d){return d.schoolId is string && exists(/databases/$(database)/documents/schools/$(d.schoolId)) && (superAdmin() || (hasProfile() && d.schoolId == p().schoolId));}
  function sameSchoolOnUpdate(){return request.resource.data.schoolId == resource.data.schoolId;}
  function classMatch(d){return d.className == p().className && d.section == (p().section == null ? '' : p().section);}
  function attachmentOk(d){return !('attachment' in d) || d.attachment == null || (d.attachment.size <= 512000 && d.attachment.dataUrl is string && d.attachment.dataUrl.size() <= 700000);}
  match /schools/{id}{
   allow read: if superAdmin() || (signedIn() && resource.data.active == true);
   allow create, update, delete: if superAdmin();
  }
  match /users/{uid}{
   allow read: if superAdmin() || (signedIn() && request.auth.uid == uid) || (active() && ((role(['principal','admin']) || role(['teacher','content_admin'])) && resource.data.schoolId == p().schoolId));
   allow create: if superAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'student' && request.resource.data.active == false && request.resource.data.email == request.auth.token.email && request.resource.data.schoolId is string && exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)) && get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.active == true;
   allow update: if superAdmin() || (role(['principal','admin']) && resource.data.schoolId == p().schoolId && request.resource.data.schoolId == resource.data.schoolId && request.resource.data.role in ['student','teacher','content_admin']) || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role && request.resource.data.active == resource.data.active && request.resource.data.email == resource.data.email && request.resource.data.schoolId == resource.data.schoolId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','updatedAt']));
   allow delete: if superAdmin() || (role(['principal']) && resource.data.schoolId == p().schoolId && resource.data.role != 'principal' && resource.data.role != 'super_admin');
  }
  match /schoolSettings/{id}{
   allow read: if schoolOk(resource.data);
   allow create: if manager() && validSchool(request.resource.data);
   allow update: if superAdmin() || (role(['principal','admin']) && schoolOk(resource.data) && sameSchoolOnUpdate() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['logo','logoUrl','schoolLogo']));
   allow delete: if superAdmin();
  }
  match /{col}/{id}{
   allow read: if col in ['directory','classes','students','subjects','resources','homework','classwork','reportCards','announcements','fees','feeBills','feeReminders','onlineTests','testSubmissions','testAnswerKeys','attendance','feedback'] && schoolOk(resource.data) &&
    (col != 'testAnswerKeys' || staff()) &&
    (col != 'feedback' || superAdmin() || resource.data.senderUid == request.auth.uid) &&
    (col != 'reportCards' || role(['principal','teacher']) || resource.data.studentUid == request.auth.uid) &&
    (col != 'fees' && col != 'feeBills' && col != 'feeReminders' && col != 'testSubmissions' || role(['principal','teacher']) || resource.data.studentUid == request.auth.uid) &&
    (col != 'homework' && col != 'classwork' && col != 'onlineTests' || role(['principal','teacher','content_admin']) || (col == 'onlineTests' ? resource.data.published == true && classMatch(resource.data) : classMatch(resource.data))) &&
    (col != 'resources' || role(['principal','teacher','content_admin']) || resource.data.visibility == 'School' || classMatch(resource.data)) &&
    (col != 'announcements' || role(['principal','teacher']) || resource.data.audience in ['Everyone','Students']);
   allow create: if col in ['directory','classes','students','subjects','resources','homework','classwork','reportCards','announcements','fees','feeBills','feeReminders','onlineTests','testSubmissions','testAnswerKeys','attendance','feedback'] && validSchool(request.resource.data) &&
    (col == 'students' ? (manager() || role(['teacher']) || (signedIn() && request.auth.uid == id && request.resource.data.portalUid == request.auth.uid && request.resource.data.active == false && request.resource.data.role == 'student')) :
     col == 'fees' ? (manager() || (active() && p().role == 'student' && request.resource.data.studentUid == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.amount is number && request.resource.data.amount > 0)) :
     col == 'testSubmissions' ? (active() && p().role == 'student' && request.resource.data.studentUid == request.auth.uid && request.resource.data.score == null) :
     col == 'feedback' ? (active() && request.resource.data.senderUid == request.auth.uid && request.resource.data.status == 'open' && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 4000) :
     col == 'attendance' ? (staff() && request.resource.data.studentUid is string && request.resource.data.status in ['present','absent','late'] && (manager() || request.resource.data.teacherUid == request.auth.uid)) :
     col in ['classes','directory','subjects','students','feeBills','feeReminders'] ? manager() :
     col in ['resources','homework','classwork','reportCards','announcements','onlineTests','testAnswerKeys'] ? staff() : false) &&
    (col != 'homework' && col != 'classwork' || attachmentOk(request.resource.data));
   allow update: if col in ['directory','classes','students','subjects','resources','homework','classwork','reportCards','announcements','fees','feeBills','feeReminders','onlineTests','testSubmissions','testAnswerKeys','attendance','feedback'] && schoolOk(resource.data) && sameSchoolOnUpdate() &&
    (col == 'feedback' ? superAdmin() :
     col == 'attendance' ? (manager() || (role(['teacher']) && resource.data.teacherUid == request.auth.uid && request.resource.data.teacherUid == request.auth.uid)) :
     col == 'students' ? (manager() || role(['teacher'])) :
     col in ['resources','homework','classwork','reportCards','announcements','onlineTests','testAnswerKeys','testSubmissions'] ? staff() :
     col in ['fees','feeBills','feeReminders','classes','subjects','directory'] ? manager() : false) &&
    (col != 'homework' && col != 'classwork' || attachmentOk(request.resource.data));
   allow delete: if col in ['directory','classes','students','subjects','resources','homework','classwork','reportCards','announcements','fees','feeBills','feeReminders','onlineTests','testSubmissions','testAnswerKeys','attendance','feedback'] && schoolOk(resource.data) && (col == 'feedback' ? superAdmin() : manager());
  }
  match /{document=**}{allow read, write: if false;}
 }
}