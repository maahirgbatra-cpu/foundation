rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function activeUser() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        profile().active == true;
    }
    function roleIn(roles) {
      return activeUser() && profile().role in roles;
    }
    function isAdmin() {
      return roleIn(['super_admin', 'admin']);
    }
    function isTeacherOrAbove() {
      return roleIn(['super_admin', 'admin', 'teacher']);
    }
    function belongsToClass(data) {
      return activeUser() &&
        data.className == profile().className &&
        data.section == (profile().section == null ? '' : profile().section);
    }
    function validAttachment(data) {
      return !('attachment' in data) || data.attachment == null ||
        (data.attachment.size <= 512000 &&
         data.attachment.dataUrl is string &&
         data.attachment.dataUrl.size() <= 700000);
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.role == 'student' &&
        request.resource.data.active == false &&
        request.resource.data.email == request.auth.token.email;
      allow read: if signedIn() &&
        (request.auth.uid == uid || roleIn(['super_admin', 'admin', 'teacher', 'content_admin']));
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.active == resource.data.active &&
         request.resource.data.email == resource.data.email);
      allow delete: if isAdmin();
    }

    match /schoolSettings/{settingId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /classes/{id} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }
    match /students/{id} {
      allow read: if roleIn(['super_admin', 'admin', 'teacher', 'content_admin']) ||
        (activeUser() && resource.data.email == request.auth.token.email);
      allow write: if roleIn(['super_admin', 'admin', 'teacher']);
    }
    match /subjects/{id} {
      allow read: if activeUser();
      allow write: if roleIn(['super_admin', 'admin', 'teacher', 'content_admin']);
    }
    match /resources/{id} {
      allow read: if activeUser() &&
        (profile().role != 'student' ||
         resource.data.visibility == 'School' ||
         (resource.data.className == profile().className &&
          resource.data.section == (profile().section == null ? '' : profile().section)));
      allow create, update, delete: if roleIn(['super_admin', 'admin', 'teacher', 'content_admin']);
    }

    match /homework/{id} {
      allow read: if activeUser() &&
        (profile().role != 'student' || belongsToClass(resource.data));
      allow create: if isTeacherOrAbove() && validAttachment(request.resource.data);
      allow update: if isTeacherOrAbove() && validAttachment(request.resource.data);
      allow delete: if isTeacherOrAbove();
    }
    match /classwork/{id} {
      allow read: if activeUser() &&
        (profile().role != 'student' || belongsToClass(resource.data));
      allow create: if isTeacherOrAbove() && validAttachment(request.resource.data);
      allow update: if isTeacherOrAbove() && validAttachment(request.resource.data);
      allow delete: if isTeacherOrAbove();
    }

    match /reportCards/{id} {
      allow read: if activeUser() &&
        (profile().role in ['super_admin', 'admin', 'teacher'] ||
         (profile().role == 'student' && resource.data.studentUid == request.auth.uid));
      allow create: if isTeacherOrAbove() &&
        request.resource.data.studentUid is string &&
        request.resource.data.studentName is string;
      allow update: if isTeacherOrAbove() &&
        request.resource.data.studentUid == resource.data.studentUid;
      allow delete: if isTeacherOrAbove();
    }

    match /fees/{id} {
      allow read: if activeUser() &&
        (profile().role in ['super_admin', 'admin', 'teacher'] ||
         (profile().role == 'student' && resource.data.studentUid == request.auth.uid));
      allow create: if activeUser() && profile().role == 'student' &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.screenshot.dataUrl is string &&
        request.resource.data.screenshot.size <= 512000;
      allow update: if isTeacherOrAbove() &&
        request.resource.data.studentUid == resource.data.studentUid &&
        request.resource.data.status in ['approved', 'rejected'];
      allow delete: if isTeacherOrAbove();
    }

    match /feeBills/{id} {
      allow read: if activeUser() &&
        (profile().role in ['super_admin', 'admin', 'teacher'] ||
         (profile().role == 'student' &&
          resource.data.studentUid == request.auth.uid));
      allow create: if isTeacherOrAbove() &&
        request.resource.data.studentUid is string &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow update, delete: if isTeacherOrAbove();
    }

    match /feeReminders/{id} {
      allow read: if activeUser() &&
        (profile().role in ['super_admin', 'admin', 'teacher'] ||
         (profile().role == 'student' &&
          resource.data.studentUid == request.auth.uid));
      allow create: if isTeacherOrAbove() &&
        request.resource.data.studentUid is string &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacherOrAbove();
    }

    match /onlineTests/{id} {
      allow read: if activeUser() &&
        (profile().role in ['super_admin', 'admin', 'teacher'] ||
         (profile().role == 'student' &&
          resource.data.published == true &&
          resource.data.className == profile().className &&
          resource.data.section == (profile().section == null ? '' : profile().section)));
      allow create: if isTeacherOrAbove() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.className is string &&
        request.resource.data.questions is list &&
        request.resource.data.questions.size() > 0;
      allow update, delete: if isTeacherOrAbove();
    }

    match /testAnswerKeys/{id} {
      allow read, write: if isTeacherOrAbove();
    }

    match /testSubmissions/{id} {
      allow read: if activeUser() &&
        (profile().role in ['super_admin', 'admin', 'teacher'] ||
         (profile().role == 'student' &&
          resource.data.studentUid == request.auth.uid));
      allow create: if activeUser() &&
        profile().role == 'student' &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.testId is string &&
        id == request.resource.data.testId + '_' + request.auth.uid &&
        exists(/databases/$(database)/documents/onlineTests/$(request.resource.data.testId)) &&
        get(/databases/$(database)/documents/onlineTests/$(request.resource.data.testId)).data.published == true &&
        get(/databases/$(database)/documents/onlineTests/$(request.resource.data.testId)).data.className == profile().className &&
        get(/databases/$(database)/documents/onlineTests/$(request.resource.data.testId)).data.section == (profile().section == null ? '' : profile().section) &&
        request.resource.data.answers is list &&
        request.resource.data.answers.size() == get(/databases/$(database)/documents/onlineTests/$(request.resource.data.testId)).data.questions.size() &&
        request.resource.data.totalMarks == get(/databases/$(database)/documents/onlineTests/$(request.resource.data.testId)).data.totalMarks &&
        request.resource.data.score == null;
      allow update: if isTeacherOrAbove() &&
        request.resource.data.studentUid == resource.data.studentUid &&
        request.resource.data.testId == resource.data.testId &&
        request.resource.data.answers == resource.data.answers &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= resource.data.totalMarks;
      allow delete: if isTeacherOrAbove();
    }

    // Attendance is restricted to teacher accounts only.
    match /attendance/{recordId} {
      allow read: if roleIn(['teacher']) &&
        resource.data.teacherUid == request.auth.uid;
      allow create: if roleIn(['teacher']) &&
        request.resource.data.teacherUid == request.auth.uid &&
        request.resource.data.studentUid is string &&
        request.resource.data.className is string &&
        request.resource.data.date is string &&
        request.resource.data.status in ['present', 'absent', 'late'];
      allow update: if roleIn(['teacher']) &&
        resource.data.teacherUid == request.auth.uid &&
        request.resource.data.teacherUid == request.auth.uid &&
        request.resource.data.studentUid == resource.data.studentUid &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.status in ['present', 'absent', 'late'];
      allow delete: if roleIn(['teacher']) &&
        resource.data.teacherUid == request.auth.uid;
    }

    // Feedback email queue. Install Firebase Trigger Email to process this collection.
    match /mail/{mailId} {
      allow create: if activeUser() &&
        request.resource.data.keys().hasOnly(['to','message','senderUid','senderName','senderEmail','createdAt']) &&
        request.resource.data.to == 'maahir.g.batra@gmail.com' &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.senderName is string &&
        request.resource.data.senderName.size() <= 100 &&
        request.resource.data.senderEmail is string &&
        request.resource.data.senderEmail.size() <= 254 &&
        request.resource.data.message is map &&
        request.resource.data.message.keys().hasOnly(['subject','text']) &&
        request.resource.data.message.subject is string &&
        request.resource.data.message.subject.size() <= 160 &&
        request.resource.data.message.text is string &&
        request.resource.data.message.text.size() >= 10 &&
        request.resource.data.message.text.size() <= 5000 &&
        request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /announcements/{id} {
      allow read: if activeUser() &&
        (profile().role != 'student' ||
         resource.data.audience in ['Everyone', 'Students']);
      allow create, update, delete: if roleIn(['super_admin', 'admin', 'teacher']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}